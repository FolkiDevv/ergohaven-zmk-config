#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        ru_on: ru_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "RU on";
            toggle-mode = "on";
        };

        ru_off: ru_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "RU off";
            toggle-mode = "off";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_to_en {
            bindings = <&switch_to_en>;
            key-positions = <16 15>;
            layers = <2>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        combo_to_ru {
            bindings = <&switch_to_ru>;
            key-positions = <16 15>;
            layers = <0 1>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        os_en: os_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp N1>,
                <&macro_release>,
                <&kp LSHFT &kp LCTRL>;
            label = "OS_EN";
        };

        os_ru: os_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT &kp LCTRL>;
            label = "OS_RU";
        };

        switch_to_ru: switch_to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&ru_on 2 &os_ru>;
            label = "SWITCH_TO_RU";
        };

        switch_to_en: switch_to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&ru_off 2 &os_en>;
            label = "SWITCH_TO_EN";
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_tap>,
                <&os_en>,
                <&macro_wait_time 100>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_wait_time 60>,
                <&os_ru>;
            label = "EN";
        };

        to_macpro: to_macpro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&to 0 &bt BT_SEL 1>;
            label = "TO_MACPRO";
        };

        to_macwork: to_macwork {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&to 0 &bt BT_SEL 2>;
            label = "TO_MACWORK";
        };

        to_win: to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&to 0 &tog 1 &bt BT_SEL 0>;
            label = "TO_WIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R      &kp T                          &kp Y  &kp U     &kp I      &kp O    &kp P     &kp BACKSPACE
&kp TAB    &kp A  &kp S  &kp D  &kp F      &kp G                          &kp H  &kp J     &kp K      &kp L    &kp SEMI  &kp LGUI
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V      &kp B  &kp LBKT     &kp RBKT   &kp N  &kp M     &kp COMMA  &kp DOT  &kp SQT   &kp RSHFT
                                &kp LCTRL  &mo 3  &kp SPACE    &kp ENTER  &mo 4  &kp LALT
            >;

            display-name = "Base";
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        winmode {
            display-name = "Win";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp ESC    &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                                                   &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp BACKSPACE
&kp TAB    &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                                                   &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp LGUI
&kp LSHFT  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &kp RU_CYRILLIC_HA    &kp RU_CYRILLIC_HARD_SIGN  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_CYRILLIC_E    &kp RSHFT
                                                                              &kp LCTRL           &mo 3               &kp SPACE             &kp ENTER                  &mo 5               &kp LALT
            >;
        };

        nav {
            bindings = <
&trans  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                                       &kp N6              &kp N7          &kp N8        &kp N9               &kp N0  &trans
&trans  &kp LG(A)  &kp HOME   &kp INS    &kp CAPS   &kp END                                      &kp LEFT_ARROW      &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW      &trans  &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp PSCRN  &switch_to_ru    &switch_to_en   &kp LA(LEFT_ARROW)  &kp PG_DN       &kp PG_UP     &kp LA(RIGHT_ARROW)  &trans  &trans
                                         &trans     &trans     &trans           &trans           &mo 6               &trans
            >;

            display-name = "Nav";
        };

        sym_en {
            bindings = <
&kp CARET     &kp AT     &kp LT    &kp EQUAL  &kp GT         &kp GRAVE                    &kp SINGLE_QUOTE   &kp LBKT  &kp UNDER  &kp RBKT  &kp DOLLAR  &kp PERCENT
&kp QUESTION  &kp SLASH  &kp LPAR  &kp MINUS  &kp RPAR       &kp PLUS                     &kp DOUBLE_QUOTES  &kp LBRC  &kp COLON  &kp RBRC  &kp SEMI    &kp EXCL
&trans        &kp HASH   &kp STAR  &kp TILDE  &kp BACKSLASH  &trans     &trans    &trans   &trans             &kp PIPE  &kp COMMA  &kp DOT   &kp AMPS    &trans
                                              &trans         &mo 6      &trans    &trans   &trans             &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols";
            bindings = <
&en CARET        &en AT_SIGN  &en LT        &kp EQUAL  &en GT       &en GRAVE                              &kp SINGLE_QUOTE      &en LBKT  &kp UNDER     &en RBKT    &en DOLLAR    &kp RU_PERCENT
&kp RU_QUESTION  &kp RU_FSLH  &kp LPAR      &kp MINUS  &kp RPAR     &kp PLUS                               &kp RU_DOUBLE_QUOTES  &en LBRC  &kp RU_COLON  &en RBRC    &kp RU_SEMI   &kp RU_EXCL
&trans           &en HASH     &kp RU_ASTRK  &en TILDE  &kp RU_BSLH  &kp RU_NUMERO  &trans         &trans   &trans                &en PIPE  &kp RU_COMMA  &kp RU_DOT  &en AMPS      &trans
                                                       &trans       &mo 6          &trans         &trans   &trans                &trans
            >;
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &to_macpro    &to_macwork   &to_win           &trans        &trans  &bt BT_CLR
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans  &studio_unlock
&tog 1       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans  &trans
                                      &trans   &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };

        navwin {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                    &trans              &trans  &trans  &trans               &trans  &trans
&trans  &kp LC(A)  &trans     &trans     &trans     &trans                    &trans              &trans  &trans  &trans               &trans  &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans  &trans    &trans  &kp LC(LEFT_ARROW)  &trans  &trans  &kp LC(RIGHT_ARROW)  &trans  &trans
                                         &trans     &trans  &trans    &trans  &trans              &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        usenavwin {
            if-layers = <1 3>;
            then-layer = <7>;
        };
    };
};
